{
    "name": "chorus",
    "version": "1.0.0",
    "description": "Decentralized P2P state synchronization library built on effector + PeerJS",
    "author": "Quentin Vanhauteghem",
    "license": "MIT",
    "engines": {
        "node": ">=18"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/QuentinV/syos.git"
    },
    "homepage": "https://github.com/QuentinV/syos/tree/main/src/chorus",
    "bugs": {
        "url": "https://github.com/QuentinV/syos/issues"
    },
    "keywords": [
        "p2p",
        "peer-to-peer",
        "webrtc",
        "state",
        "synchronization",
        "sync",
        "effector",
        "peerjs",
        "react",
        "realtime",
        "collaborative",
        "turn-based",
        "serverless"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./style.css": "./dist/style.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run test && npm run build"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "effector": "^23.0.0",
        "effector-react": "^23.0.0"
    },
    "dependencies": {
        "peerjs": "^1.5.4",
        "qrcode.react": "^4.2.0",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "effector": "^23.3.0",
        "effector-react": "^23.3.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "typescript": "^5.8.3",
        "vite": "^5.4.8",
        "vitest": "^2.1.0"
    }
}